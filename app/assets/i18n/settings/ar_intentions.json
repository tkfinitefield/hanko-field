    },
    {
      "key_path": "faq.items[2].answer",
      "source_file": "app/assets/i18n/settings/en.json",
      "source_value": "Production usually takes 5-10 business days after payment and design confirmation. Shipping usually takes about 7-14 days after dispatch.",
