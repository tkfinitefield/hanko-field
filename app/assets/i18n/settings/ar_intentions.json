    {
      "key_path": "faq.items[0].question",
      "source_file": "app/assets/i18n/settings/en.json",
      "source_value": "How is kanji selected?",
      "target_locale": "ar",
      "reason_code": "locale_not_release_enabled",
      "reviewer": "codex",
      "date": "2026-06-18"
    },
    {
      "key_path": "faq.items[0].answer",
      "source_file": "app/assets/i18n/settings/en.json",
      "source_value": "Kanji is suggested from your name, the desired meaning, and the balance of the seal design. You can review candidates before choosing the design direction.",
      "target_locale": "ar",
      "reason_code": "locale_not_release_enabled",
      "reviewer": "codex",
      "date": "2026-06-18"
    },
    {
      "key_path": "faq.items[1].question",
      "source_file": "app/assets/i18n/settings/en.json",
      "source_value": "Can I change my order after payment?",
      "target_locale": "ar",
      "reason_code": "locale_not_release_enabled",
      "reviewer": "codex",
      "date": "2026-06-18"
    },
    {
      "key_path": "faq.items[1].answer",
      "source_file": "app/assets/i18n/settings/en.json",
      "source_value": "Because each seal is custom-made, changes may not be possible after production starts. Review the design, stone, shipping details, and terms before completing payment.",
      "target_locale": "ar",
      "reason_code": "locale_not_release_enabled",
      "reviewer": "codex",
      "date": "2026-06-18"
    },
    {
      "key_path": "faq.items[2].question",
      "source_file": "app/assets/i18n/settings/en.json",
      "source_value": "How long does production take?",
      "target_locale": "ar",
      "reason_code": "locale_not_release_enabled",
      "reviewer": "codex",
